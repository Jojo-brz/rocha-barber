# Porta do Servidor HTTP
PORT=8080

# String de conexão PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:senha@host-neon.aws.neon.tech/banco?sslmode=require

# Chave secreta para assinatura de tokens HMAC (use um valor longo e aleatório em produção)
AUTH_SECRET=troque-por-uma-chave-secreta-forte

# Origens autorizadas para CORS (separadas por vírgula em caso de múltiplos domínios)
FRONTEND_URL=http://localhost:3000
